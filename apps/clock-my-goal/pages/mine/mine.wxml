<view class="page with-tab">
  <block wx:if="{{loggedIn}}">
    <view class="profile">
      <view class="avatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <van-icon wx:else name="contact" size="40px" color="#5a8fc7" />
      </view>
      <view class="nick">
        <text>{{nickname}}</text>
      </view>
      <view class="stats">
        <view class="stat">
          <text class="num ongoing">{{ongoing}}</text>
          <text class="stat-label">进行中</text>
        </view>
        <view class="stat">
          <text class="num done">{{completed}}</text>
          <text class="stat-label">已完成</text>
        </view>
        <view class="stat">
          <text class="num expired">{{expired}}</text>
          <text class="stat-label">已过期</text>
        </view>
      </view>
      <view class="note">数量按当前计划的截止时间和打卡次数计算。头像暂用默认图，修改昵称的接口还没有。</view>
      <button class="btn logout" hover-class="btn-hover" bindtap="onLogout">退出登录</button>
    </view>
  </block>

  <block wx:else>
    <view class="group">
      <view class="cell">
        <view class="label">用户名<text class="req">*</text></view>
        <input
          class="field"
          value="{{account.userName}}"
          placeholder="中文、字母或·"
          placeholder-class="ph"
          data-field="userName"
          bindinput="onAccount"
          cursor-spacing="80"
        />
      </view>
      <view class="err" wx:if="{{errors.userName}}">{{errors.userName}}</view>

      <view class="cell {{mode === 'login' ? 'no-line' : ''}}">
        <view class="label">密码<text class="req">*</text></view>
        <input
          class="field"
          password
          value="{{account.password}}"
          placeholder="6到20位"
          placeholder-class="ph"
          data-field="password"
          bindinput="onAccount"
          cursor-spacing="80"
        />
      </view>
      <view class="err" wx:if="{{errors.password}}">{{errors.password}}</view>

      <block wx:if="{{mode === 'register'}}">
        <view class="cell no-line">
          <view class="label">性别</view>
        </view>
        <view class="seg sex">
          <button
            class="seg-btn {{account.sex === item.value ? 'on' : ''}}"
            wx:for="{{sexes}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="onSex"
            hover-class="btn-hover"
          >{{item.label}}</button>
        </view>
        <view class="cell no-line">
          <view class="label">年龄<text class="opt">选填</text></view>
          <input
            class="field"
            type="number"
            value="{{account.age}}"
            placeholder="0到150"
            placeholder-class="ph"
            data-field="age"
            bindinput="onAccount"
            cursor-spacing="80"
          />
        </view>
        <view class="err" wx:if="{{errors.age}}">{{errors.age}}</view>
      </block>
    </view>
    <button class="btn" hover-class="btn-hover" bindtap="onSubmit">{{mode === 'login' ? '登录' : '注册并登录'}}</button>
    <view class="switch" bindtap="onToggleMode">{{mode === 'login' ? '没有账号？去注册' : '已有账号？去登录'}}</view>
  </block>
</view>
