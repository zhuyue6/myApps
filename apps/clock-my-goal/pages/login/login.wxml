<view class="page">
  <view class="hero">
    <view class="hero-title">{{mode === 'login' ? '登录' : '注册'}}</view>
    <view class="hero-desc">登录后可管理打卡计划与标签</view>
  </view>

  <view class="group">
    <view class="cell" data-field="userName" bindtap="onFieldTap">
      <view class="label">用户名<text class="req">*</text></view>
      <input
        class="field"
        value="{{account.userName}}"
        placeholder="中文、字母或·"
        placeholder-class="ph"
        data-field="userName"
        focus="{{focusField === 'userName'}}"
        bindtap="onFieldTap"
        bindfocus="onFieldFocus"
        bindblur="onFieldBlur"
        bindinput="onAccount"
        cursor-spacing="80"
      />
    </view>
    <view class="err" wx:if="{{errors.userName}}">{{errors.userName}}</view>

    <view class="cell {{mode === 'login' ? 'no-line' : ''}}" data-field="password" bindtap="onFieldTap">
      <view class="label">密码<text class="req">*</text></view>
      <input
        class="field"
        password
        value="{{account.password}}"
        placeholder="6到20位"
        placeholder-class="ph"
        data-field="password"
        focus="{{focusField === 'password'}}"
        bindtap="onFieldTap"
        bindfocus="onFieldFocus"
        bindblur="onFieldBlur"
        bindinput="onAccount"
        cursor-spacing="80"
      />
    </view>
    <view class="err" wx:if="{{errors.password}}">{{errors.password}}</view>

    <block wx:if="{{mode === 'register'}}">
      <view class="cell no-line">
        <view class="label">性别</view>
      </view>
      <view class="seg sex">
        <button
          class="seg-btn {{account.sex === item.value ? 'on' : ''}}"
          wx:for="{{sexes}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="onSex"
          hover-class="btn-hover"
        >{{item.label}}</button>
      </view>
      <view class="cell no-line" data-field="age" bindtap="onFieldTap">
        <view class="label">年龄<text class="opt">选填</text></view>
        <input
          class="field"
          type="number"
          value="{{account.age}}"
          placeholder="0到150"
          placeholder-class="ph"
          data-field="age"
          focus="{{focusField === 'age'}}"
          bindtap="onFieldTap"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          bindinput="onAccount"
          cursor-spacing="80"
        />
      </view>
      <view class="err" wx:if="{{errors.age}}">{{errors.age}}</view>
    </block>
  </view>

  <button class="btn" hover-class="btn-hover" bindtap="onSubmit">{{mode === 'login' ? '登录' : '注册并登录'}}</button>
  <view class="switch" bindtap="onToggleMode">{{mode === 'login' ? '没有账号？去注册' : '已有账号？去登录'}}</view>
</view>
