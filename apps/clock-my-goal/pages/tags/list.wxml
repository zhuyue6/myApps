<view class="page {{tags.length ? 'with-action' : 'with-tab'}}">
  <block wx:if="{{loaded && !tags.length}}">
    <view class="empty">
      <view class="illus">
        <van-icon name="label-o" size="48px" color="#8eb4d8" />
      </view>
      <view class="empty-title">{{needLogin ? '请先登录' : '还没有标签'}}</view>
      <view class="empty-desc">{{needLogin ? '登录后才能管理标签' : '标签用来给计划分类。计划可以不关联标签。'}}</view>
      <button wx:if="{{needLogin}}" class="btn" hover-class="btn-hover" bindtap="onGoLogin">去登录</button>
      <button wx:else class="btn" hover-class="btn-hover" bindtap="onCreate">新增标签</button>
    </view>
  </block>

  <block wx:else>
    <view
      class="card"
      wx:for="{{tags}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      hover-class="card-hover"
    >
      <view class="mark"></view>
      <view class="row">
        <view>
          <view class="tag-kicker">类型</view>
          <view class="tag-value">{{item.type}}</view>
        </view>
        <text class="chev">›</text>
      </view>
      <view class="row tag-foot">
        <view>
          <view class="tag-kicker">名称</view>
          <view class="tag-name">{{item.name}}</view>
        </view>
        <button
          class="btn-text"
          hover-class="btn-hover"
          catchtap="onAskDelete"
          data-id="{{item.id}}"
          data-type="{{item.type}}"
          data-name="{{item.name}}"
        >删除</button>
      </view>
    </view>
  </block>
</view>

<view class="action-bar" wx:if="{{tags.length}}">
  <button class="btn" hover-class="btn-hover" bindtap="onCreate">新增标签</button>
</view>
