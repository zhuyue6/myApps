<view class="page {{readonly ? '' : 'with-action'}}">
  <view class="banner" wx:if="{{readonly}}">已完成，仅可查看</view>
  <view class="group">
    <view class="cell {{readonly ? 'readonly' : ''}}">
      <view class="label">名称<text class="req" wx:if="{{!readonly}}">*</text></view>
      <input
        class="field"
        value="{{form.name}}"
        placeholder="请输入计划名称"
        placeholder-class="ph"
        bindinput="onName"
        cursor-spacing="80"
        disabled="{{readonly}}"
      />
    </view>
    <view class="err" wx:if="{{errors.name}}">{{errors.name}}</view>

    <view class="cell {{readonly ? 'readonly' : ''}}" bindtap="onOpenTime">
      <view class="label">计划截止时间<text class="req" wx:if="{{!readonly}}">*</text></view>
      <view class="val {{form.deadline ? '' : 'ph'}}">{{form.deadline || '请选择'}}</view>
      <text class="chev" wx:if="{{!readonly}}">›</text>
    </view>
    <view class="err" wx:if="{{errors.deadline}}">{{errors.deadline}}</view>

    <view class="cell no-line {{readonly ? 'readonly' : ''}}">
      <view class="label">周期<text class="req" wx:if="{{!readonly}}">*</text></view>
    </view>
    <view class="seg">
      <button
        class="seg-btn {{form.cycle === item.value ? 'on' : ''}}"
        wx:for="{{cycles}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onCycle"
        hover-class="{{readonly ? '' : 'btn-hover'}}"
        disabled="{{readonly}}"
      >{{item.label}}</button>
    </view>
    <view class="help" wx:if="{{!errors.cycle}}">目标次数由系统根据周期和截止时间自动计算</view>
    <view class="err" wx:if="{{errors.cycle}}">{{errors.cycle}}</view>

    <view class="cell count-cell {{readonly ? 'readonly' : ''}}">
      <view class="label">单次周期打卡总数<text class="req" wx:if="{{!readonly}}">*</text></view>
      <view class="stepper">
        <button
          class="step"
          hover-class="{{readonly ? '' : 'btn-hover'}}"
          data-delta="-1"
          bindtap="onCycleCount"
          disabled="{{readonly || form.cycleCount <= 1}}"
        >－</button>
        <input
          class="step-input"
          type="number"
          value="{{form.cycleCount}}"
          maxlength="3"
          bindinput="onCycleCountInput"
          bindblur="onCycleCountBlur"
          disabled="{{readonly}}"
          cursor-spacing="80"
        />
        <button
          class="step"
          hover-class="{{readonly ? '' : 'btn-hover'}}"
          data-delta="1"
          bindtap="onCycleCount"
          disabled="{{readonly || form.cycleCount >= cycleCountMax}}"
        >＋</button>
      </view>
    </view>
    <view class="help" wx:if="{{!errors.cycleCount && mode === 'edit'}}">每个周期内需要完成的打卡次数。修改后会清空已打卡次数</view>
    <view class="help" wx:if="{{!errors.cycleCount && mode !== 'edit'}}">每个周期内需要完成的打卡次数</view>
    <view class="err" wx:if="{{errors.cycleCount}}">{{errors.cycleCount}}</view>

    <view class="cell {{readonly ? 'readonly' : ''}}" bindtap="onOpenCheckTime" data-edge="start">
      <view class="label">开始时间<text class="opt" wx:if="{{!readonly}}">选填</text></view>
      <view class="val {{form.checkStart ? '' : 'ph'}}">{{form.checkStart || (form.checkEnd ? '请选择' : '全天')}}</view>
      <text class="chev" wx:if="{{!readonly}}">›</text>
    </view>
    <view class="cell {{readonly ? 'readonly' : ''}}" bindtap="onOpenCheckTime" data-edge="end">
      <view class="label">结束时间<text class="opt" wx:if="{{!readonly}}">选填</text></view>
      <view class="val {{form.checkEnd ? '' : 'ph'}}">{{form.checkEnd || (form.checkStart ? '请选择' : '全天')}}</view>
      <text class="chev" wx:if="{{!readonly}}">›</text>
    </view>
    <view class="help" wx:if="{{!errors.checkTime}}">不填表示全天可打卡。开始时间须早于结束时间</view>
    <view class="err" wx:if="{{errors.checkTime}}">{{errors.checkTime}}</view>
    <view class="help" wx:if="{{!readonly && (form.checkStart || form.checkEnd)}}">
      <text class="time-clear" bindtap="onClearCheckTime">改为全天</text>
    </view>

    <view class="cell {{readonly ? 'readonly' : ''}}" bindtap="onOpenTag">
      <view class="label">标签<text class="opt" wx:if="{{!readonly}}">选填</text></view>
      <view class="val {{form.tagId ? '' : 'ph'}}">{{form.tagId ? tagText : '可不选'}}</view>
      <text class="chev" wx:if="{{!readonly}}">›</text>
    </view>
    <view class="err" wx:if="{{errors.tag}}">{{errors.tag}}</view>

    <view class="cell remark-cell no-line {{readonly ? 'readonly' : ''}}">
      <view class="remark-head">
        <view class="label">备注<text class="opt" wx:if="{{!readonly}}">选填</text></view>
        <text class="remark-count" wx:if="{{!readonly}}">{{remarkLen}}/500</text>
      </view>
      <textarea
        class="remark-input"
        value="{{form.remark}}"
        maxlength="500"
        placeholder="请输入备注，500字以内"
        placeholder-class="ph"
        bindinput="onRemark"
        auto-height
        cursor-spacing="120"
        show-confirm-bar="{{false}}"
        disabled="{{readonly}}"
      />
    </view>
    <view class="err" wx:if="{{errors.remark}}">{{errors.remark}}</view>
  </view>

  <block wx:if="{{mode === 'edit'}}">
    <view class="sec">系统记录，不可修改</view>
    <view class="group">
      <view class="cell readonly">
        <view class="label">目标次数</view>
        <view class="val">{{targetCount}}</view>
      </view>
      <view class="cell readonly">
        <view class="label">已打卡次数</view>
        <view class="val">{{checkedCount}}</view>
      </view>
      <view class="cell readonly">
        <view class="label">本周期已打卡</view>
        <view class="val">{{cycleChecked}}</view>
      </view>
      <view class="cell readonly">
        <view class="label">创建时间</view>
        <view class="val">{{createdAt}}</view>
      </view>
      <view class="cell readonly no-line">
        <view class="label">状态</view>
        <view class="val">{{statusText}}</view>
      </view>
    </view>
    <view class="help">{{statusHelp}}</view>

    <view class="sec">打卡流水</view>
    <view class="group" wx:if="{{clockIns.length}}">
      <view class="cell readonly" wx:for="{{clockIns}}" wx:key="id">
        <view class="label flow-label">
          <text>{{item.label}}</text>
          <text class="flow-latest" wx:if="{{item.latest}}">最近</text>
        </view>
        <view class="val">{{item.time}}</view>
      </view>
    </view>
    <view class="group" wx:else>
      <view class="cell readonly no-line">
        <view class="flow-empty">本周期还没有打卡</view>
      </view>
    </view>
    <view class="help">只展示当前周期内的打卡时间，最近一次在最上面</view>
  </block>
</view>

<view class="action-bar solo" wx:if="{{!readonly}}">
  <button class="btn" hover-class="btn-hover" bindtap="onSave">保存</button>
</view>

<van-popup show="{{showTime}}" position="bottom" round z-index="{{200}}" bind:close="onCloseTime">
  <view class="sheet" catchtouchmove="noop">
    <view class="sheet-head">
      <text class="sheet-btn" bindtap="onCloseTime">取消</text>
      <text class="sheet-title">选择截止时间</text>
      <text class="sheet-btn ok" bindtap="onTimeConfirm">确定</text>
    </view>
    <view class="col-labels">
      <text>年</text><text>月</text><text>日</text>
    </view>
    <van-picker
      id="timePicker"
      wx:if="{{showTime}}"
      columns="{{timeColumns}}"
      visible-item-count="{{5}}"
      item-height="{{44}}"
      bind:change="onTimeChange"
    />
  </view>
</van-popup>

<van-popup show="{{showClock}}" position="bottom" round z-index="{{200}}" bind:close="onCloseClock">
  <view class="sheet" catchtouchmove="noop">
    <view class="sheet-head">
      <text class="sheet-btn" bindtap="onCloseClock">取消</text>
      <text class="sheet-title">{{clockTitle}}</text>
      <text class="sheet-btn ok" bindtap="onClockConfirm">确定</text>
    </view>
    <view class="col-labels">
      <text>时</text><text>分</text><text>秒</text>
    </view>
    <van-picker
      id="clockPicker"
      wx:if="{{showClock}}"
      columns="{{clockColumns}}"
      visible-item-count="{{5}}"
      item-height="{{44}}"
    />
  </view>
</van-popup>

<van-popup show="{{showTag}}" position="bottom" round z-index="{{200}}" bind:close="onCloseTag">
  <view class="sheet">
    <view class="sheet-head">
      <text class="sheet-btn" bindtap="onCloseTag">取消</text>
      <text class="sheet-title">选择标签</text>
      <text class="sheet-btn ok" bindtap="onTagConfirm">确定</text>
    </view>
    <scroll-view scroll-y class="sheet-scroll" style="height: {{sheetHeight}}rpx;">
      <view
        class="option {{draftTagId === item.id ? 'on' : ''}}"
        wx:for="{{tagOptions}}"
        wx:key="text"
        data-id="{{item.id}}"
        bindtap="onPickTag"
      >
        <text>{{item.text}}</text>
        <view class="check"></view>
      </view>
    </scroll-view>
  </view>
</van-popup>
