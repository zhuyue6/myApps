.page.with-action {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.ph {
  color: #b4bec8;
}

.remark-cell {
  flex-direction: column;
  align-items: stretch;
}

.remark-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.remark-head .label {
  width: auto;
}

.remark-count {
  color: #8b98a8;
  font-size: 24rpx;
}

.remark-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 12rpx;
  padding: 0;
  font-size: 30rpx;
  line-height: 1.5;
  color: #1c2834;
  box-sizing: border-box;
}

.field[disabled],
.remark-input[disabled] {
  color: #5f6d7c;
  background: transparent;
}

button.seg-btn[disabled] {
  opacity: 1;
}

button.seg-btn[disabled].on {
  background: #5a8fc7;
  color: #ffffff;
}

.count-cell .label {
  width: auto;
  flex: 1;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

button.step {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #f3f6fa;
  color: #1c2834;
  font-size: 36rpx;
  text-align: center;
}

button.step::after {
  border: none;
}

button.step[disabled] {
  color: #c5ced6;
  background: #f3f6fa;
}

.step-input {
  width: 88rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #f3f6fa;
  color: #1c2834;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.step-input[disabled] {
  color: #5f6d7c;
  background: #f3f6fa;
}

.time-clear {
  color: #5a8fc7;
}
