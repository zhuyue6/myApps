page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1c2834;
  background: #f5f7fb;
  font-size: 28rpx;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
}

.page.with-tab {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.page.with-action {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

.card {
  position: relative;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(40, 70, 100, 0.06);
  padding: 20rpx 24rpx 16rpx 28rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.mark {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #5a8fc7;
}

.mark.done {
  background: #2f9e6b;
}

.mark.expired {
  background: #c48a3a;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  word-break: break-all;
}

.chev {
  color: #c5ced6;
  font-size: 36rpx;
  font-weight: 400;
  flex-shrink: 0;
}

.pill {
  font-size: 24rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.pill.go {
  color: #3f74ad;
  background: #e8f3fb;
}

.pill.done {
  color: #2f9e6b;
  background: #e8f7ef;
}

.pill.expired {
  color: #9a6b22;
  background: #fbf4e8;
}

.meta {
  margin-top: 8rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 1.4;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  font-size: 24rpx;
  color: #3f74ad;
  background: #e8f3fb;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
}

.chip.muted {
  color: #6d7b8a;
  background: #f3f6fa;
}

.progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.bar {
  flex: 1;
  height: 12rpx;
  background: #e7eef5;
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  background: #5a8fc7;
  border-radius: 12rpx;
}

.bar-inner.done {
  background: #2f9e6b;
}

.bar-inner.expired {
  background: #c48a3a;
}

.frac {
  font-size: 26rpx;
  color: #1c2834;
  font-weight: 600;
  white-space: nowrap;
}

.ops {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.reason {
  font-size: 24rpx;
  color: #8b98a8;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  padding: 20rpx 32rpx 16rpx;
  background: #ffffff;
  z-index: 20;
  box-sizing: border-box;
}

.action-bar.solo {
  bottom: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

button.btn,
button.btn-text,
button.seg-btn {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  text-align: center;
}

button.btn::after,
button.btn-text::after,
button.seg-btn::after {
  border: none;
}

button.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #5a8fc7;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  width: 100%;
  display: block;
}

button.btn.small {
  height: 64rpx;
  line-height: 64rpx;
  width: auto;
  padding: 0 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  display: inline-block;
}

button.btn.off,
button.btn[disabled] {
  background: #e8edf2 !important;
  color: #a3adb8 !important;
}

button.btn-text {
  border: 0;
  background: transparent;
  color: #d9655b;
  font-size: 28rpx;
  padding: 0 16rpx;
  height: 64rpx;
  line-height: 64rpx;
  width: auto;
  display: inline-block;
}

.btn-hover {
  opacity: 0.86;
}

.empty {
  min-height: calc(100vh - 180rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 72rpx 80rpx;
  box-sizing: border-box;
}

.illus {
  width: 192rpx;
  height: 192rpx;
  border-radius: 56rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(40, 70, 100, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 16rpx;
  color: #6d7b8a;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty .btn {
  margin-top: 40rpx;
  width: 360rpx;
}

.banner {
  background: #e8f7ef;
  color: #217a4e;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 16rpx;
}

.group {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(40, 70, 100, 0.06);
  margin-bottom: 20rpx;
}

.cell {
  min-height: 104rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #eef1f5;
  box-sizing: border-box;
}

.cell.no-line,
.cell:last-child {
  border-bottom: 0;
}

.label {
  width: 216rpx;
  font-size: 30rpx;
  flex-shrink: 0;
}

.opt {
  color: #8b98a8;
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 8rpx;
}

.req {
  color: #e07a72;
  margin-left: 4rpx;
}

.val {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1c2834;
  min-width: 0;
  word-break: break-all;
}

.ph {
  color: #b4bec8;
}

.field {
  flex: 1;
  border: 0;
  background: transparent;
  text-align: right;
  font-size: 30rpx;
  color: #1c2834;
  min-width: 0;
  height: 64rpx;
}

.help {
  padding: 0 28rpx 20rpx;
  color: #8b98a8;
  font-size: 24rpx;
  line-height: 1.5;
}

.err {
  padding: 0 28rpx 20rpx;
  color: #d9655b;
  font-size: 24rpx;
  line-height: 1.5;
}

.seg {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx 8rpx;
}

button.seg-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 20rpx;
  border: 0;
  background: #f3f6fa;
  color: #6d7b8a;
  font-size: 28rpx;
  display: block;
}

button.seg-btn.on {
  background: #5a8fc7;
  color: #ffffff;
  font-weight: 600;
}

.sec {
  margin: 8rpx 8rpx 16rpx;
  font-size: 26rpx;
  color: #8b98a8;
}

.readonly {
  background: #fbfcfe;
}

.readonly .val {
  color: #5f6d7c;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(22, 32, 44, 0.46);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -16rpx 48rpx rgba(20, 40, 60, 0.12);
}

.sheet-head {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eef1f5;
  font-size: 30rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-btn {
  min-width: 144rpx;
  height: 88rpx;
  line-height: 88rpx;
  color: #6d7b8a;
  font-size: 32rpx;
  padding: 0 24rpx;
}

.sheet-btn.ok {
  color: #5a8fc7;
  font-weight: 600;
  text-align: right;
}

.col-labels {
  display: flex;
  padding: 16rpx 16rpx 0;
}

.col-labels text {
  flex: 1;
  text-align: center;
  color: #8b98a8;
  font-size: 24rpx;
}

.option {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #eef1f5;
  box-sizing: border-box;
}

.option.on {
  color: #5a8fc7;
  font-weight: 600;
}

.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #d5dde6;
  box-sizing: border-box;
  flex-shrink: 0;
}

.option.on .check {
  border-color: #5a8fc7;
  background: #5a8fc7;
  box-shadow: inset 0 0 0 6rpx #ffffff;
}

.drop {
  margin: 0 24rpx 12rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(30, 50, 70, 0.12);
  overflow: hidden;
}

.sheet-scroll {
  max-height: 624rpx;
}

.sheet-pad {
  padding: 32rpx;
}

.nick-input {
  width: 100%;
  height: 92rpx;
  border-radius: 24rpx;
  background: #f3f6fa;
  padding: 0 28rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.tag-kicker {
  margin: 0;
  color: #6d7b8a;
  font-size: 26rpx;
}

.tag-value {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tag-name {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 400;
}
